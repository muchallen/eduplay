# =====================================================================
# Eduplay backend configuration. Copy to .env and fill in real values.
# NEVER commit .env. Every value below is a placeholder.
# =====================================================================

# --- Runtime -----------------------------------------------------------
# dev | staging | prod
SPRING_PROFILES_ACTIVE=prod
APP_VERSION=1.0.0
# Host interface/port the API is published on. Keep 127.0.0.1 when a reverse
# proxy (nginx/Caddy) on the same host terminates TLS.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
APP_MEMORY_LIMIT=1g
# Set to "native" when running behind a reverse proxy that sends X-Forwarded-* headers.
FORWARD_HEADERS_STRATEGY=native
SWAGGER_ENABLED=false
# Comma-separated browser origins allowed by CORS (empty = none; Unity does not need CORS).
CORS_ALLOWED_ORIGINS=

# --- Database: option 1, local PostgreSQL container (--profile local) ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=eduplay
DB_USERNAME=eduplay
DB_PASSWORD=change-me-strong-database-password
# disable | allow | prefer | require | verify-ca | verify-full
DB_SSL_MODE=prefer
DB_POOL_SIZE=10

# --- Database: option 2, Supabase (--profile supabase) -------------------
# Either set the parts above to the Supabase values, e.g.
#   DB_HOST=aws-0-<region>.pooler.supabase.com   (session pooler, port 5432)
#   DB_USERNAME=postgres.<project-ref>
#   DB_NAME=postgres
#   DB_SSL_MODE=require
# or provide one full connection string (JDBC or postgresql:// form):
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# --- JWT -----------------------------------------------------------------
# Base64 secret of at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-output-of-openssl-rand-base64-48
# Comma-separated retired secrets still accepted for verification during rotation.
JWT_PREVIOUS_SECRETS=
JWT_ISSUER=eduplay-backend
JWT_ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# A rotated refresh token retried within this period (lost response) gets the same replacement.
REFRESH_TOKEN_REUSE_GRACE=60s

# --- SMTP email --------------------------------------------------------------
MAIL_ENABLED=true
MAIL_FROM=Eduplay <no-reply@your-domain.example>
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_USERNAME=smtp-username
SMTP_PASSWORD=smtp-password
SMTP_AUTH=true
SMTP_STARTTLS=true
# Links placed in emails (app deep links or a web page that forwards to the app).
APP_PASSWORD_RESET_URL=https://your-domain.example/reset-password
APP_EMAIL_VERIFICATION_URL=https://your-domain.example/verify-email

# --- Privacy, retention and subscriptions ---------------------------------
PRIVACY_POLICY_VERSION=2026-01
DELETED_DATA_RETENTION=30d
SUBSCRIPTION_TRIAL_PERIOD=14d
MAX_CHILDREN_PER_PARENT=10
MAX_CHILDREN_PER_TEACHER=300
# Grades the app teaches (comma-separated).
GRADES=ecd_a,ecd_b

# --- Rate limiting -------------------------------------------------------
RATE_LIMIT_ENABLED=true
